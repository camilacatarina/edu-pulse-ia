{
  "entities": {
    "Institution": {
      "title": "Institution",
      "description": "Educational institution tenant boundary isolating all academic and AI records.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "joinCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array", "description": "Bounded list (<= 50) of ADMIN and TEACHER UIDs belonging to this institution." },
        "retentionDays": { "type": "integer", "description": "Data retention policy duration in days (30-1825)." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "joinCode", "ownerUid", "staffUids", "retentionDays", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII role and institution membership profile for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["ADMIN", "TEACHER", "STUDENT"] },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "linkedStudentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "institutionId", "role", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII subcollection for user email and privacy preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "institutionId", "updatedAt"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Academic cohort or classroom within an institution.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "gradeLevel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "academicYear": { "type": "string", "minLength": 4, "maxLength": 20 },
        "teacherUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "name", "gradeLevel", "academicYear", "teacherUid", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student academic record using pseudonymId for AI processing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentOwnerUid": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pseudonymId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "gradeLevel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "pedagogicalStatus": { "type": "string", "enum": ["Mastering", "Progressing", "Needs Reinforcement", "Additional Practice Recommended"] },
        "averageScore": { "type": "number" },
        "completionRate": { "type": "number" },
        "subjectIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentOwnerUid", "classId", "pseudonymId", "displayName", "gradeLevel", "pedagogicalStatus", "averageScore", "completionRate", "subjectIds", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Curriculum discipline offered by an institution.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "code": { "type": "string", "minLength": 2, "maxLength": 24 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "name", "code", "createdAt"]
    },
    "Competency": {
      "title": "Competency",
      "description": "Specific measurable skill or learning standard tied to a subject.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 600 },
        "gradeLevel": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "subjectId", "code", "name", "description", "gradeLevel", "createdAt"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Formal or diagnostic assessment linked to a subject and competency.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "competencyId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "type": { "type": "string", "enum": ["Diagnostic Assessment", "Revision Quiz", "Multiple Choice", "Short Answer"] },
        "difficulty": { "type": "string", "enum": ["Foundational", "Intermediate", "Advanced"] },
        "isHighImpact": { "type": "boolean" },
        "questions": { "type": "array" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "classId", "subjectId", "competencyId", "title", "type", "difficulty", "isHighImpact", "questions", "createdByUid", "createdAt"]
    },
    "AssessmentResult": {
      "title": "AssessmentResult",
      "description": "Student submission and score for an assessment, triggering autonomous analysis.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentOwnerUid": { "type": "string", "maxLength": 128 },
        "assessmentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "competencyId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "percentage": { "type": "number" },
        "teacherReviewed": { "type": "boolean" },
        "aiPreliminaryFeedback": { "type": "string", "maxLength": 2000 },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentOwnerUid", "assessmentId", "studentId", "subjectId", "competencyId", "score", "maxScore", "percentage", "teacherReviewed", "submittedAt"]
    },
    "LearningActivity": {
      "title": "LearningActivity",
      "description": "Interactive pedagogical activity (teacher-created or AI-generated).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentOwnerUid": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "competencyId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "type": { "type": "string", "enum": ["Multiple Choice", "True or False", "Short Answer", "Practice Exercises", "Diagnostic Assessment", "Revision Quiz"] },
        "difficulty": { "type": "string", "enum": ["Foundational", "Intermediate", "Advanced"] },
        "origin": { "type": "string", "enum": ["AI_AUTONOMOUS", "TEACHER_CREATED"] },
        "status": { "type": "string", "enum": ["ASSIGNED", "IN_PROGRESS", "COMPLETED"] },
        "questions": { "type": "array" },
        "scorePercentage": { "type": "number" },
        "feedbackSummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentOwnerUid", "studentId", "classId", "subjectId", "competencyId", "title", "type", "difficulty", "origin", "status", "questions", "createdAt", "updatedAt"]
    },
    "LearningPath": {
      "title": "LearningPath",
      "description": "Individualized adaptive learning path generated and updated by the Autonomous Learning Engine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentOwnerUid": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "competencyId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "educationalObjective": { "type": "string", "maxLength": 600 },
        "estimatedLevel": { "type": "string", "enum": ["Foundational", "Developing", "Proficient", "Mastering"] },
        "masteryCriterion": { "type": "string", "maxLength": 240 },
        "nextReviewDate": { "type": "string", "maxLength": 40 },
        "progressPercent": { "type": "number" },
        "modules": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentOwnerUid", "studentId", "subjectId", "competencyId", "title", "educationalObjective", "estimatedLevel", "masteryCriterion", "nextReviewDate", "progressPercent", "modules", "updatedAt"]
    },
    "Intervention": {
      "title": "Intervention",
      "description": "Autonomous pedagogical intervention generated in response to detected learning gaps.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentOwnerUid": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "competencyId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceEventId": { "type": "string", "maxLength": 128 },
        "evidence": { "type": "string", "maxLength": 800 },
        "strategy": { "type": "string", "maxLength": 300 },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "status": { "type": "string", "enum": ["CREATED", "ASSIGNED", "IN_PROGRESS", "COMPLETED", "REASSESSMENT_REQUIRED"] },
        "contentSummary": { "type": "string", "maxLength": 2000 },
        "activityIds": { "type": "array" },
        "outcomeSummary": { "type": "string", "maxLength": 800 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentOwnerUid", "studentId", "subjectId", "competencyId", "sourceEventId", "evidence", "strategy", "priority", "status", "contentSummary", "activityIds", "createdAt", "updatedAt"]
    },
    "LearningEvent": {
      "title": "LearningEvent",
      "description": "Idempotent event trigger processed by the Autonomous Learning Engine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentOwnerUid": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "enum": ["AssessmentSubmitted", "ActivityCompleted", "LearningGoalUpdated", "CompetencyMasteryChanged", "StudentProgressUpdated"] },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 128 },
        "competencyId": { "type": "string", "maxLength": 128 },
        "referenceId": { "type": "string", "maxLength": 128 },
        "idempotencyKey": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSED", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentOwnerUid", "eventType", "studentId", "subjectId", "competencyId", "referenceId", "idempotencyKey", "status", "createdAt"]
    },
    "AIInsight": {
      "title": "AIInsight",
      "description": "Structured pedagogical decision and reasoning output produced by the Autonomous Learning Engine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentOwnerUid": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "pseudonymId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "competencyId": { "type": "string", "maxLength": 128 },
        "evidence": { "type": "string", "maxLength": 1000 },
        "pedagogicalDiagnosis": { "type": "string", "maxLength": 1500 },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "strategyChosen": { "type": "string", "maxLength": 400 },
        "learningObjective": { "type": "string", "maxLength": 400 },
        "confidence": { "type": "number" },
        "engineSource": { "type": "string", "enum": ["GEMINI", "DEMO_RULES", "RULE_ENGINE_FALLBACK"] },
        "observedOutcome": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentOwnerUid", "eventId", "studentId", "pseudonymId", "subjectId", "competencyId", "evidence", "pedagogicalDiagnosis", "priority", "strategyChosen", "learningObjective", "confidence", "engineSource", "observedOutcome", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail for AI engine actions, teacher reviews, and data privacy events.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorType": { "type": "string", "enum": ["AI_ENGINE", "ADMIN", "TEACHER", "STUDENT"] },
        "action": { "type": "string", "maxLength": 120 },
        "targetCollection": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "actorUid", "actorType", "action", "targetCollection", "targetId", "summary", "createdAt"]
    },
    "ConsentRecord": {
      "title": "ConsentRecord",
      "description": "Minor data protection, consent, and retention governance record per student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "studentId": { "type": "string", "maxLength": 128 },
        "guardianConsentStatus": { "type": "string", "enum": ["VERIFIED", "PENDING", "REVOKED"] },
        "dataMinimizationAccepted": { "type": "boolean" },
        "retentionPolicyDays": { "type": "integer" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "staffUids", "studentId", "guardianConsentStatus", "dataMinimizationAccepted", "retentionPolicyDays", "updatedByUid", "updatedAt"]
    },
    "InstitutionDirectory": {
      "title": "InstitutionDirectory",
      "description": "Publicly non-listable join-code lookup record mapping a joinCode to institutionId and name without PII.",
      "type": "object",
      "properties": {
        "joinCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["joinCode", "institutionId", "name", "ownerUid", "createdAt"]
    }
  },
  "firestore": {
    "/institutions/{institutionId}": {
      "schema": { "$ref": "#/entities/Institution" },
      "description": "Root tenant workspace for an educational institution."
    },
    "/institutionDirectory/{joinCode}": {
      "schema": { "$ref": "#/entities/InstitutionDirectory" },
      "description": "Single-document join-code lookup (get-only, list disabled)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User role and institution assignment document."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection accessible only to the owner or platform admin."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/SchoolClass" },
      "description": "Academic classes scoped to an institution."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student records scoped to an institution."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Subjects scoped to an institution."
    },
    "/competencies/{competencyId}": {
      "schema": { "$ref": "#/entities/Competency" },
      "description": "Learning competencies scoped to an institution."
    },
    "/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/Assessment" },
      "description": "Assessments scoped to an institution."
    },
    "/assessmentResults/{resultId}": {
      "schema": { "$ref": "#/entities/AssessmentResult" },
      "description": "Student assessment submissions scoped to an institution and student."
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/LearningActivity" },
      "description": "Personalized learning activities scoped to an institution and student."
    },
    "/learningPaths/{pathId}": {
      "schema": { "$ref": "#/entities/LearningPath" },
      "description": "Adaptive learning paths scoped to an institution and student."
    },
    "/interventions/{interventionId}": {
      "schema": { "$ref": "#/entities/Intervention" },
      "description": "Autonomous pedagogical interventions scoped to an institution and student."
    },
    "/learningEvents/{eventId}": {
      "schema": { "$ref": "#/entities/LearningEvent" },
      "description": "Idempotent learning event log scoped to an institution."
    },
    "/aiInsights/{insightId}": {
      "schema": { "$ref": "#/entities/AIInsight" },
      "description": "AI Intelligence Center analytical decisions scoped to an institution."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable institution audit trail."
    },
    "/consentRecords/{consentId}": {
      "schema": { "$ref": "#/entities/ConsentRecord" },
      "description": "Student data governance and consent records."
    }
  }
}
